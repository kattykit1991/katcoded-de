# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare / OpenNext
/.open-next/
/.wrangler/
.dev.vars*


# Only runtime assets required by the website (including fonts and licenses).
/design-system/**
!/design-system/CUTE_COZY/
!/design-system/CUTE_COZY/branding/
!/design-system/CUTE_COZY/fonts/
!/design-system/CUTE_COZY/icons/
