!/design-system/CUTE_COZY/fonts/NunitoSans.ttf
!/design-system/CUTE_COZY/fonts/OFL-NunitoSans.txt
!/design-system/CUTE_COZY/fonts/OFL-Quicksand.txt
!/design-system/CUTE_COZY/fonts/Quicksand.ttf
!/design-system/CUTE_COZY/fonts/SOURCES.md
!/design-system/CUTE_COZY/icons/code.svg
!/design-system/CUTE_COZY/icons/file.svg
!/design-system/CUTE_COZY/icons/folder.svg
!/design-system/CUTE_COZY/icons/home.svg
!/design-system/CUTE_COZY/icons/info.svg
